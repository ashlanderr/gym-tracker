android/gradlew text eol=lf
*.mp4 filter=lfs diff=lfs merge=lfs -text
media/**/*.webp filter=lfs diff=lfs merge=lfs -text
media/**/*.png filter=lfs diff=lfs merge=lfs -text
media/**/*.jpg filter=lfs diff=lfs merge=lfs -text
src/client/db/exercises/assets/** filter=lfs diff=lfs merge=lfs -text
# SVG frames are text: LFS would cost bandwidth and hide every diff, while git
# stores and packs them perfectly well on its own.
src/client/db/exercises/assets/*.svg !filter !diff !merge text eol=lf
